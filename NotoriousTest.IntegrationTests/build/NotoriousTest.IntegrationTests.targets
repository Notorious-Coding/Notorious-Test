<Project>
	<Target Name="CopyDoggyDogDev" AfterTargets="Build">
		<PropertyGroup>
			<DoggyDogRuntime Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</DoggyDogRuntime>
			<DoggyDogRuntime Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</DoggyDogRuntime>
		</PropertyGroup>

		<Message Text="Publishing DoggyDog to $(OutDir)" Importance="high" />
		<Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)../../DoggyDog/DoggyDog.csproj&quot; -r $(DoggyDogRuntime) --self-contained -p:PublishSingleFile=true -o &quot;$(OutDir)&quot;" />
	</Target>
</Project>