<Project>
	<Target Name="CopyDoggyDogDev" AfterTargets="Build">
		<PropertyGroup>
			<DoggyDogDir Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(MSBuildThisFileDirectory)../../tools/win-x64/</DoggyDogDir>
			<DoggyDogDir Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(MSBuildThisFileDirectory)../../tools/linux-x64/</DoggyDogDir>
			<DoggyDogRuntime Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</DoggyDogRuntime>
			<DoggyDogRuntime Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</DoggyDogRuntime>
		</PropertyGroup>

		<Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)../../DoggyDog/DoggyDog.csproj&quot; -r $(DoggyDogRuntime) --self-contained -p:PublishSingleFile=true -o &quot;$(DoggyDogDir)&quot;" />

		<ItemGroup>
			<DoggyDogFiles Include="$(DoggyDogDir)*" />
		</ItemGroup>

		<Message Text="DoggyDog files: @(DoggyDogFiles)" Importance="high" />
		<Copy SourceFiles="@(DoggyDogFiles)" DestinationFolder="$(OutDir)" />
	</Target>
</Project>