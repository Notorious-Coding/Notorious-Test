<Project>
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None Include="$(MSBuildThisFileDirectory)icon.png" Pack="true" PackagePath="" Visible="False" />
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="" Visible="False" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath="" Visible="False" />
  </ItemGroup>

  <Target Name="CopyDoggyDogDev" AfterTargets="Build" Condition="'$(IsIntegrationTest)' == 'true'">
    <PropertyGroup>
      <DoggyDogRuntime Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</DoggyDogRuntime>
      <DoggyDogRuntime Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux-x64</DoggyDogRuntime>
      <DoggyDogArtifactsDir>$(MSBuildThisFileDirectory)artifacts\doggydog\$(DoggyDogRuntime)\</DoggyDogArtifactsDir>
    </PropertyGroup>

    <Warning Text="DoggyDog artifacts not found at '$(DoggyDogArtifactsDir)'. Build the DoggyDog project first."
             Condition="!Exists('$(DoggyDogArtifactsDir)')" />

    <ItemGroup>
      <DoggyDogFiles Include="$(DoggyDogArtifactsDir)*" Condition="Exists('$(DoggyDogArtifactsDir)')" />
    </ItemGroup>

    <Message Text="Copying DoggyDog from $(DoggyDogArtifactsDir) to $(OutDir)" Importance="high" />
    <Copy SourceFiles="@(DoggyDogFiles)" DestinationFolder="$(OutDir)" Condition="'@(DoggyDogFiles)' != ''" />
  </Target>
</Project>
