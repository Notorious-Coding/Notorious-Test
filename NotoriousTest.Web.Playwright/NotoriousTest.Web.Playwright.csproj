<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Description>Playwright browser end-to-end tests support for NotoriousTest.</Description>
    <PackageId>NotoriousTest.Web.Playwright</PackageId>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="NotoriousTest.IntegrationTests"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NotoriousTest.Web\NotoriousTest.Web.csproj"/>
  </ItemGroup>

</Project>
